---
import { skillGroups } from '../data/skills';
---

<section id="tecnologias" class="page section">
  <h2 class="section-title">Tecnologías</h2>
  <div class="groups">
    {
      skillGroups.map((group) => (
        <div>
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((item) => (
              <li>
                <img class:list={{ invert: item.invert }} src={item.logo} alt="" width="28" height="28" loading="lazy" />
                {item.name}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 2.5rem;
  }

  h3 {
    margin-block-end: 1rem;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--line);
    color: var(--muted);
    font-size: 1rem;
    font-weight: 500;
  }

  ul {
    display: grid;
    gap: 0.75rem;
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  img {
    width: 1.75rem;
    height: 1.75rem;
    object-fit: contain;
  }

  .invert {
    filter: invert(1);
  }
</style>
