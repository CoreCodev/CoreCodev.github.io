---
import { Image } from 'astro:assets';
import photo from '../assets/profile/sebastian-rabanal-francia.jpeg';
import GithubIcon from '../assets/icons/github.svg';
import LinkedinIcon from '../assets/icons/linkedin.svg';
import InstagramIcon from '../assets/icons/instagram.svg';
import { profile } from '../data/profile';

const socials = [
  { href: profile.socials.github, label: 'GitHub de Sebastian Rabanal', Icon: GithubIcon },
  { href: profile.socials.linkedin, label: 'LinkedIn de Sebastian Rabanal', Icon: LinkedinIcon },
  { href: profile.socials.instagram, label: 'Instagram de Sebastian Rabanal', Icon: InstagramIcon },
];
---

<section id="inicio" class="hero" data-pointer data-glow>
  <Image
    class="hero-photo"
    src={photo}
    alt={`${profile.name} programando de noche frente a su laptop, con la habitación iluminada de verde`}
    width={1400}
    widths={[640, 960, 1400]}
    sizes="(max-width: 56rem) 100vw, 60vw"
    format="webp"
    quality={78}
    priority
  />
  <div class="page hero-content">
    <h1 class="hero-name" data-letters>
      {profile.name.split(' ').map((word, index) => <span style={`--i: ${index}`}>{word} </span>)}
    </h1>
    <p class="hero-role">{profile.role}. Construyo soluciones con inteligencia artificial: asistentes que responden con tus propios datos y automatizaciones que se encargan del trabajo repetitivo.</p>
    <div class="hero-actions">
      <a class="btn btn-solid" href="#proyectos">Ver proyectos</a>
      <a class="btn" href={profile.cv} target="_blank" rel="noopener">Ver CV</a>
      <ul class="socials">
        {
          socials.map(({ href, label, Icon }) => (
            <li>
              <a href={href} target="_blank" rel="noopener me" aria-label={label}>
                <Icon width={24} height={24} fill="currentColor" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--nav-height));
    overflow: hidden;
    padding-block: 2.5rem;
    --glow-size: 26rem;
    --glow-strength: 18%;
  }

  .hero-photo {
    position: absolute;
    top: 0;
    right: 0;
    width: 62%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 25%;
    -webkit-mask-image: linear-gradient(to right, transparent, black 45%);
    mask-image: linear-gradient(to right, transparent, black 45%);
  }

  .hero-content {
    /* El cursor solo le importa a la foto y al brillo: aquí se corta para no recalcular el texto. */
    --mx: 0;
    --my: 0;
    position: relative;
  }

  .hero-name {
    margin-block-end: 1.75rem;
    width: fit-content;
    background: linear-gradient(135deg, var(--accent), var(--accent-2), var(--accent)) 0 0 / 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(3.75rem, min(12vw, 14.5svh), 11rem);
    font-stretch: 75%;
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.01em;
  }

  .hero-name span {
    display: block;
  }

  .hero-role {
    max-width: 34rem;
    margin-block-end: 2rem;
    font-size: var(--text-lead);
    line-height: 1.45;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .socials {
    display: flex;
    margin-inline-start: 0.5rem;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    color: var(--muted);
    transition: color 0.2s, translate 0.3s var(--spring);
  }

  .socials a:hover {
    color: var(--accent);
  }

  @media (max-width: 56rem) {
    .hero {
      display: block;
      min-height: 0;
      padding-block: 0 1rem;
    }

    .hero-photo {
      position: relative;
      width: 100%;
      height: 38svh;
      object-position: 70% 30%;
      -webkit-mask-image: linear-gradient(to top, transparent, black 40%);
      mask-image: linear-gradient(to top, transparent, black 40%);
    }

    .hero-content {
      margin-block-start: -5rem;
    }

    .hero-name {
      font-size: clamp(3rem, 18.5vw, 8rem);
    }

    .socials {
      margin-inline-start: -0.5rem;
    }
  }

  /* Al cargar: la habitación se enciende, el nombre se estira y luego entra el resto. */
  @media screen and (prefers-reduced-motion: no-preference) {
    .hero-photo {
      /* La escala evita que asomen los bordes de la foto al moverla. */
      scale: 1.06;
      translate: calc(var(--mx, 0) * -28px) calc(var(--my, 0) * -18px);
      transition: translate 0.5s var(--ease);
      animation: lights-on 1.6s var(--ease) backwards;
    }

    .hero-name span {
      animation: stretch 1s var(--ease) calc(var(--i) * 80ms) backwards;
    }

    /* La foto baja más despacio que la página. Por separado: ver la nota de la barra en Nav. */
    @supports (animation-timeline: scroll()) {
      .hero-photo {
        animation-name: lights-on, drift;
        animation-duration: 1.6s, auto;
        animation-timing-function: var(--ease), linear;
        animation-fill-mode: backwards, both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 100vh;
      }

      /* El nombre se comprime al bajar y se vuelve a estirar al subir. */
      .hero-name span {
        animation-name: stretch, squeeze;
        animation-duration: 1s, auto;
        animation-timing-function: var(--ease), linear;
        animation-delay: calc(var(--i) * 80ms), 0s;
        animation-fill-mode: backwards, both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 90vh;
      }

      /* El bloque se apaga según su salida real de la pantalla, sea cual sea su altura. */
      .hero-content {
        animation-name: leave;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit;
      }
    }

    .hero-name {
      animation:
        rise 0.6s var(--ease) backwards,
        flow 4s ease-in-out 1s 2 alternate;
    }

    .hero-role {
      animation: rise 0.7s var(--ease) 0.45s backwards;
    }

    .hero-actions {
      animation: rise 0.7s var(--ease) 0.6s backwards;
    }

    /* Sobre el <li>, que no se mueve: si el icono detectara el cursor, parpadearía en su borde. */
    .socials li:hover a {
      translate: 0 -4px;
    }
  }

  @keyframes leave {
    50% {
      opacity: 1;
    }
    to {
      opacity: 0.15;
      translate: 0 -4rem;
    }
  }

  @keyframes squeeze {
    to {
      font-stretch: 52%;
    }
  }

  @keyframes drift {
    to {
      transform: translateY(18vh);
    }
  }

  @keyframes lights-on {
    from {
      opacity: 0;
      scale: 1.16;
      filter: brightness(0.3) saturate(0.5);
    }
  }

  @keyframes stretch {
    from {
      font-stretch: 50%;
    }
  }

  @keyframes flow {
    to {
      background-position: 100% 0;
    }
  }
</style>
