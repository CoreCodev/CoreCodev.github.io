---
import { experience } from '../data/experience';
---

<section id="experiencia" class="page section">
  <h2 class="section-title" data-reveal data-letters>Experiencia</h2>
  <ol class="timeline">
    {
      experience.map((item) => (
        <li data-reveal>
          {item.period && <p class="period">{item.period}</p>}
          <div class="entry">
            <h3>{item.role}</h3>
            {item.place && <p class="place">{item.place}</p>}
            <p class="detail">{item.detail}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  li {
    position: relative;
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1.75rem;
  }

  /* La línea de cada etapa se dibuja de izquierda a derecha. */
  li::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    border-block-start: 1px solid var(--line);
    transform-origin: left;
    transition: border-color 0.3s, scale 1.1s var(--ease) var(--delay, 0s);
  }

  li:hover::before {
    border-color: var(--accent);
  }

  .entry {
    transition: translate 0.35s var(--ease);
  }

  .period {
    color: var(--accent);
    font-weight: 600;
  }

  h3 {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .place {
    margin-block-start: 0.25rem;
  }

  .detail {
    margin-block-start: 0.5rem;
    max-width: var(--measure);
    color: var(--muted);
  }

  @media (min-width: 40rem) {
    li {
      grid-template-columns: 10rem 1fr;
    }

    .entry {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    li:hover .entry {
      translate: 0.5rem 0;
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.motion) li:not(.is-visible)::before {
      scale: 0 1;
    }
  }
</style>
