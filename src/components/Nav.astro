---
const links = [
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#experiencia', label: 'Experiencia' },
  { href: '#sobre-mi', label: 'Sobre mí' },
  { href: '#tecnologias', label: 'Tecnologías' },
  { href: '#certificaciones', label: 'Certificaciones' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="nav">
  <nav class="page nav-inner" aria-label="Principal">
    <a class="logo" href="#inicio">&lt;Core_Codev&gt;</a>
    <button class="btn menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links">Menú</button>
    <ul class="nav-links" id="nav-links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const setOpen = (open: boolean) => toggle.setAttribute('aria-expanded', String(open));

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  // Se cierra al elegir un enlace, al tocar fuera del menú y al desplazarse.
  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    if (target.closest('#nav-links a') || !target.closest('.nav')) setOpen(false);
  });
  window.addEventListener('scroll', () => setOpen(false), { passive: true });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>

<style>
  .nav {
    position: sticky;
    z-index: 10;
    top: 0;
    border-block-end: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--nav-height);
  }

  .logo {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-stretch: 90%;
    font-weight: 700;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 1.75rem;
  }

  .nav-links a {
    display: block;
    padding-block: 0.5rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .nav-links a:hover {
    color: var(--accent);
  }

  .menu-toggle {
    display: none;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border-color: var(--line);
    font-weight: 400;
  }

  @media (max-width: 56rem) {
    .menu-toggle {
      display: inline-flex;
    }

    .nav-links {
      position: absolute;
      inset: 100% 0 auto;
      display: none;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 1.25rem 1rem;
      border-block-end: 1px solid var(--line);
      background: var(--bg);
    }

    .nav-links a {
      padding-block: 0.75rem;
      color: var(--text);
    }

    .menu-toggle[aria-expanded='true'] + .nav-links {
      display: flex;
    }
  }
</style>
