---
const links = [
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#experiencia', label: 'Experiencia' },
  { href: '#sobre-mi', label: 'Sobre mí' },
  { href: '#tecnologias', label: 'Tecnologías' },
  { href: '#certificaciones', label: 'Certificaciones' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="nav">
  <nav class="page nav-inner" aria-label="Principal">
    <a class="logo" href="#inicio">&lt;Core<span class="caret">_</span>Codev&gt;</a>
    <button class="btn menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links">Menú</button>
    <ul class="nav-links" id="nav-links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const setOpen = (open: boolean) => toggle.setAttribute('aria-expanded', String(open));

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  // Se cierra al elegir un enlace, al tocar fuera del menú y al desplazarse.
  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    if (target.closest('#nav-links a') || !target.closest('.nav')) setOpen(false);
  });
  window.addEventListener('scroll', () => setOpen(false), { passive: true });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  const links = document.querySelectorAll<HTMLAnchorElement>('#nav-links a');
  const mark = (id: string) =>
    links.forEach((link) => {
      if (link.hash === `#${id}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });

  // Marca en el menú la sección que pasa justo debajo de él, donde aterriza cada enlace al hacer clic.
  const current = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) if (entry.isIntersecting) mark(entry.target.id);
    },
    { rootMargin: '-15% 0px -80% 0px' },
  );
  document.querySelectorAll('main section[id]').forEach((section) => current.observe(section));

  // Contacto puede no subir tanto porque la página se acaba: ver el pie significa que ya se está ahí.
  new IntersectionObserver(([footer]) => {
    if (footer.isIntersecting) mark('contacto');
  }).observe(document.querySelector('footer')!);

  // Cerca del final caben varias secciones en pantalla: tras un clic manda el enlace elegido.
  let chosen = '';
  const settle = () => {
    if (chosen) mark(chosen);
    chosen = '';
  };
  links.forEach((link) =>
    link.addEventListener('click', () => {
      chosen = link.hash.slice(1);
      // Si la página ya estaba ahí no se mueve, y entonces no llega el aviso de fin del desplazamiento.
      const from = scrollY;
      setTimeout(() => {
        if (scrollY === from) settle();
      }, 150);
    }),
  );
  addEventListener('scrollend', settle);
</script>

<style>
  .nav {
    position: sticky;
    z-index: 10;
    top: 0;
    border-block-end: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--nav-height);
  }

  .logo {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-stretch: 90%;
    font-weight: 700;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 1.75rem;
  }

  .nav-links a {
    position: relative;
    display: block;
    padding-block: 0.5rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    inset: auto 0 0.25rem;
    height: 2px;
    background: var(--gradient-accent);
    transform-origin: left;
    scale: 0 1;
    transition: scale 0.35s var(--ease);
  }

  .nav-links a:hover {
    color: var(--accent);
  }

  .nav-links a[aria-current] {
    color: var(--text);
  }

  .nav-links a:hover::after,
  .nav-links a[aria-current]::after {
    scale: 1 1;
  }

  .menu-toggle {
    display: none;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border-color: var(--line);
    font-weight: 400;
  }

  @media (max-width: 56rem) {
    .menu-toggle {
      display: inline-flex;
    }

    .nav-links {
      position: absolute;
      inset: 100% 0 auto;
      display: none;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 1.25rem 1rem;
      border-block-end: 1px solid var(--line);
      background: var(--bg);
    }

    .nav-links a {
      padding-block: 0.75rem;
      color: var(--text);
    }

    .menu-toggle[aria-expanded='true'] + .nav-links {
      display: flex;
    }

    .nav-links a::after {
      right: auto;
      width: 3rem;
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    /* El guion bajo del logo parpadea como un cursor de terminal. */
    .caret {
      animation: blink 1s steps(2, jump-none) 4;
    }

    .logo:hover .caret {
      animation-iteration-count: infinite;
    }

    .menu-toggle[aria-expanded='true'] + .nav-links {
      animation: rise 0.3s var(--ease);
    }

    /* Barra que avanza con la lectura de la página. */
    @supports (animation-timeline: scroll()) {
      .nav::after {
        content: '';
        position: absolute;
        inset: auto 0 -1px;
        height: 2px;
        background: var(--gradient-accent);
        transform-origin: left;
        /* Por separado: el compresor de CSS las une en una forma corta que Chrome rechaza. */
        animation-name: read;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes read {
    from {
      scale: 0 1;
    }
  }
</style>
