---
import { Image } from 'astro:assets';
import GithubIcon from '../assets/icons/github.svg';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card" data-glow>
  <Image
    class="cover"
    src={project.image}
    alt={project.alt}
    width={800}
    widths={[420, 640, 800]}
    sizes="(min-width: 64rem) 23rem, (min-width: 40rem) calc(50vw - 90px), calc(86vw - 34px)"
    format="webp"
    quality={78}
    loading="lazy"
  />
  <div class="body">
    <h3>{project.name}</h3>
    <p class="summary">{project.summary}</p>
    <ul class="tags" aria-label="Tecnologías">
      {project.stack.map((tech) => <li>{tech}</li>)}
    </ul>
    {project.note && <p class="note">{project.note}</p>}
    <div class="actions">
      <a class="btn action" href={project.code} target="_blank" rel="noopener">
        <GithubIcon width={18} height={18} fill="currentColor" aria-hidden="true" />
        Código
      </a>
      {
        project.demo && (
          <a class="btn btn-solid action" href={project.demo} target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 3h6v6M21 3l-9 9M18 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5" />
            </svg>
            Ver demo
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .card {
    --glow-size: 14rem;
    --glow-strength: 14%;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: border-color 0.2s, box-shadow 0.3s, transform 0.3s var(--ease);
  }

  /* El cursor se detecta en el <li>, que no se mueve: en la tarjeta parpadearía en su borde. */
  :global(li:hover) > .card,
  .card:focus-within {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    box-shadow: var(--shadow-glow);
  }

  :global(li:hover) > .card::after {
    opacity: 1;
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    transition: scale 0.6s var(--ease);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem 1.5rem;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .summary {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  /* Empuja etiquetas y botones al fondo para alinearlos entre tarjetas. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-block-start: auto;
    padding-block-start: 0.25rem;
  }

  .tags li {
    padding: 0.1875rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .note {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-block-start: 0.25rem;
  }

  .action {
    flex: 1 1 auto;
    white-space: nowrap;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    font-size: var(--text-small);
  }

  .action:not(.btn-solid):not(:hover) {
    border-color: var(--line);
  }

  /* La tarjeta sube y se inclina hacia el cursor. */
  @media (prefers-reduced-motion: no-preference) {
    :global(li:hover) > .card,
    .card:focus-within {
      transform: perspective(60rem) translateY(-6px) rotateX(calc(var(--my, 0) * -5deg)) rotateY(calc(var(--mx, 0) * 5deg));
    }

    :global(li:hover) > .card .cover {
      scale: 1.05;
    }
  }
</style>
